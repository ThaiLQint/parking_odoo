<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="stock_move_line_tree" model="ir.ui.view">
        <field name="name">stock.move.line.tree</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position='replace' />
            <xpath expr="//field[@name='location_dest_id']" position='replace' />
            <!-- <xpath expr="//field[@name='qty_done']" position='replace' /> -->
            <xpath expr="//field[@name='state']" position='replace' />

            <xpath expr="//field[@name='product_id']" position='attributes'>
                <attribute name="widget">many2one_avatar</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position='after'>
                <field name="picking_code" widget="badge" decoration-muted="picking_code == 'outgoing'" decoration-success="picking_code == 'incoming'" />
            </xpath>
            <xpath expr="//field[@name='product_id']" position='after'>
                <field name="contact_id" widget="many2one_avatar" />
                <field name="bien_so_realtime"/>
            </xpath>
          
            <xpath expr="//field[@name='quantity']" position='replace'>
            </xpath>
             <xpath expr="//field[@name='bien_so_realtime']" position='replace'>
            </xpath>
             <xpath expr="//field[@name='create_uid']" position='replace'>
            </xpath>
             <xpath expr="//field[@name='product_uom_id']" position='replace'>
            </xpath>

        </field>
    </record>
    <record id="stock_move_line_search" model="ir.ui.view">
        <field name="name">stock.move.line.search</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='done']" position='replace' />
        </field>
    </record>
    <record id="stock_move_line_form" model="ir.ui.view">
        <field name="name">stock.move.line.form</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position='replace' />
            <xpath expr="//sheet" position='replace' />
            <xpath expr="//header" position='after'>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" invisible="1" />
                            <field name="date" modifiers="{&quot;required&quot;: true}" string="Thời gian tạo"/>

                            <field required="{'invisible': [('picking_code', '!=', 'outgoing')]}" name="date_in" />
                            <field required="{'invisible': [('picking_code', '!=', 'outgoing')]}" name="date_sub_in_out" />
                            <field name="contact_id" on_change="1" can_create="true" can_write="true" />
                        </group>
                        <group>
                            <!-- 'no_open': True -->
                            <field name="picking_code" widget="badge" decoration-muted="picking_code == 'outgoing'" decoration-success="picking_code == 'incoming'" />
                            <field name="location_id" options="{'no_create': True}" modifiers="{&quot;required&quot;: true}" can_create="true" can_write="true" />
                            <field name="product_id" on_change="1" can_create="true" can_write="true" />
                            <field name="bien_so_realtime" invisible="1"/>

                        </group>
                        <group>
                            <field name="image_1920_ng" widget="image" class="oe_avatar text-start float-none" options="{'size': [160, 160]}"/>
                        </group>
                        <group>
                            <field name="image_1920_xe" widget="image" class="oe_avatar text-start float-none" options="{'size': [160, 160]}"/>
                        </group>
                        <group>
                            <field name="image_1920_camera_truoc" widget="image" class="oe_avatar text-start float-none" options="{'size': [160, 160]}"/>
                        </group>
                        <group>
                            <field name="image_1920_camera_sau" widget="image" class="oe_avatar text-start float-none" options="{'size': [160, 160]}"/>
                        </group>
                        <group>
                            <field name="i_1920_cam_trc_before" widget="image" class="oe_avatar text-start float-none" options="{'size': [160, 160]}"/>
                        </group>
                        <group>
                            <field name="i_1920_cam_sau_before" widget="image" class="oe_avatar text-start float-none" options="{'size': [160, 160]}"/>
                        </group>
                        <group>
                            <field name="image_1920_bs_camera" widget="image" class="oe_avatar text-start float-none" options="{'size': [160, 160]}"/>
                        </group>
                        <group>
                            <field name="i_1920_bs_cam_before" widget="image" class="oe_avatar text-start float-none" options="{'size': [160, 160]}"/>
                        </group>
                    </group>
                </sheet>
            </xpath>
        </field>
    </record>
</odoo>