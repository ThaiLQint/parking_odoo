<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action for adding color -->
        <record id="action_add_color_setting" model="ir.actions.act_window">
            <field name="name">Add color</field>
            <field name="res_model">add.action.model</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu item for adding color -->
        <menuitem id="menu_add_color_setting" 
                  name="Add Color" 
                  parent="stock.menu_product_in_config_stock" 
                  sequence="0" 
                  action="action_add_color_setting" 
                  groups="base.group_system" />
    </data>
</odoo>


