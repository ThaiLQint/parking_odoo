<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="setting_nsp_view_form" model="ir.ui.view">
            <field name="name">setting.nsp.form</field>
            <field name="model">setting.nsp.branch</field>
            <field name="arch" type="xml">
                <form js_class="nsp_branch_form_view">
                    <sheet
                        style="border: 0px solid #ccc; max-width: 800px; margin-left: auto; margin-right: auto;">
                        <group>
                            <field name="name"  />
                            <field name="id" invisible="0" />
                            <field name="parking_ids"  />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="setting_nsp_parking_view_form" model="ir.ui.view">
            <field name="name">setting.nsp.parking.form</field>
            <field name="model">setting.nsp.parking</field>
            <field name="arch" type="xml">
                <form string="Setting NSP Bãi xe"  js_class="nsp_branch_form_view">
                    <sheet
                        style="border: 0px solid #ccc; max-width: 800px; margin-left: auto; margin-right: auto;"
                    >
                        <group>
                            <field name="name" />
                            <field name="branch_id" invisible="0" />
                            <field name="id" invisible="0" />
                            <field name="office_ids" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="setting_nsp_office_view_form" model="ir.ui.view">
            <field name="name">setting.nsp.office.form</field>
            <field name="model">setting.nsp.office</field>
            <field name="arch" type="xml">
                <form string="Setting NSP Văn phòng">
                    <sheet
                        style="border: 0px solid #ccc; max-width: 800px; margin-left: auto; margin-right: auto;"
                    >
                        <group>
                            <field name="name" />
                            <field name="parking_id" invisible="0" />
                            <field name="id" invisible="0" />
                            <field name="lane_in_ids" invisible="0" />
                            <field name="lane_out_ids" invisible="0" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="setting_nsp_lane_out_view_form" model="ir.ui.view">
            <field name="name">setting.nsp.lane.in.form</field>
            <field name="model">setting.nsp.lane.in</field>
            <field name="arch" type="xml">
                <form string="Setting NSP Cổng vào">
                    <sheet
                        style="border: 0px solid #ccc; max-width: 800px; margin-left: auto; margin-right: auto;"
                    >
                        <group>
                            <field name="name" />
                            <field name="office_id" invisible="0" />
                            <field name="id" invisible="0" />
                            <field name="device_ids" invisible="0" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="setting_nsp_lane_out_view_form" model="ir.ui.view">
            <field name="name">setting.nsp.lane.out.form</field>
            <field name="model">setting.nsp.lane.out</field>
            <field name="arch" type="xml">
                <form string="Setting NSP Cổng ra">
                    <sheet
                        style="border: 0px solid #ccc; max-width: 800px; margin-left: auto; margin-right: auto;"
                    >
                        <group>
                            <field name="name" />
                            <field name="office_id" invisible="0" />
                            <field name="id" invisible="0" />
                            <field name="device_ids" invisible="0" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="setting_nsp_tree_view" model="ir.ui.view">
            <field name="name">setting.nsp.tree</field>
            <field name="model">setting.nsp.branch</field>
            <field name="arch" type="xml">
                <tree string="Setting NSP">
                    <field name="create_date" />
                    <field name="name" />
                </tree>
            </field>
        </record>
    </data>
</odoo>