<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="product_template_tree_inherit2" model="ir.ui.view">
            <field name="name">product.template.tree</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view" />
            <field name="arch" type="xml">
                <xpath expr="//tree/field[@name='default_code']" position="after">
                    <field name="barcode2" />
                </xpath>
            </field>
        </record>

        <record id="product_template_tree_inherit" model="ir.ui.view">
            <field name="name">product.template.tree</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view" />
            <field name="arch" type="xml">
                <xpath expr="//tree/field[@name='product_tag_ids']" position="replace"></xpath>
                <xpath expr="//tree/field[@name='standard_price']" position="replace" />
                <xpath expr="//tree/field[@name='list_price']" position="replace" />
                <xpath expr="//tree/field[@name='qty_available']" position="replace" />
                <xpath expr="//tree/field[@name='virtual_available']" position="replace" />
                <xpath expr="//tree/field[@name='responsible_id']" position="replace" />
                <!-- <xpath expr="//tree/field[@name='priority']" position="replace" /> -->

                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="string"></attribute>
                </xpath>
                <xpath expr="//tree/field[@name='default_code']" position="attributes">
                    <attribute name="string">Mã thẻ</attribute>
                </xpath>
                <xpath expr="//tree/field[@name='default_code']" position="after">
                    <field name="barcode" />
                    <field name="categ_id" />
                    <field name="contact_id" widget='many2one_avatar' />
                    <field name="user_ids" widget='many2many_tags_avatar' />
                    <field name="so_khung" string="Số khung xe" />
                    <field name="move_history_id" />
                    <field name='so_loai' string="Mã kiểu loại" placeholder="SH 125I"></field>
                    <field name='so_may' string="Số máy" placeholder="JF08E-0028585"></field>

                    <!-- <field name="location_id" /> -->
                    <!-- <field name="tracking" /> -->
                </xpath>
            </field>
        </record>

        <record id="product_template_form_inherit" model="ir.ui.view">
            <field name="name">product.template.form</field>
            <field name="model">product.template</field>
            <!-- <field name="context">{'id':id}</field> -->
            <field name="inherit_id" ref="product.product_template_only_form_view" />

            <field name="arch" type="xml">
                <xpath expr="//div[@class='oe_chatter']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//header" position="replace"></xpath>

                <xpath expr="//form" position="attributes">
                    <attribute name="js_class">rfid_button</attribute>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="replace"></xpath>

                <xpath expr="//label[@for='name']" position="attributes">
                    <attribute name="string">BIỂN SỐ XE</attribute>
                </xpath>
                <xpath expr="//form/sheet/div[@class='oe_title']/h1/div/field[@name='name']"
                    position="attributes">
                    <attribute name="placeholder">e.g. 54A12123</attribute>
                </xpath>
                <xpath expr="//form/sheet/div[@name='options']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//form/sheet/notebook" position="attributes">
                    <attribute name="invisible">0</attribute>
                </xpath>
                <xpath expr="//form/sheet/field[@name='image_1920']" position="replace">
                    <field name="image_1920" widget="image" class="oe_avatar"
                        options="{'zoom': true}" />
                </xpath>

                <!-- <xpath expr="//page[@name='invoicing']" position="replace"></xpath> -->
                <xpath expr="//page[@name='general_information']" position="replace"></xpath>
                <xpath expr="//page[@name='sales']" position="replace"></xpath>
                <xpath expr="//page[@name='purchase']" position="replace"></xpath>
                <xpath expr="//page[@name='variants']" position="replace"></xpath>
                <xpath expr="//page[@name='inventory']" position="replace"></xpath>

                <xpath expr="//form/sheet/notebook">
                    <page string="Thông tin chung" name="general_information">
                        <group>
                            <field name="active" invisible="1" />
                            <group>
                                <field name="contact_id" widget="many2one_avatar"
                                    options="{'no_create':True, 'no_create_edit':True, 'no_open': True, 'color_field': 'color'}" />
                            </group>
                        </group>

                        <div class="o_row" style="display: flex; align-items: flex-start;">
                            <div class="o_col-24" style="flex: 1;">
                                <group>
                                    <label for="user_ids" string="Người sử dụng:" />
                                    <div class="o_row" style="display: flex;">
                                        <field name="domain" invisible="1" />
                                        <field name="user_ids" add-label="Thêm người dùng"
                                            nolabel="1" domain="domain" context="{'id':id}"
                                            class="oe_inline btn_color">
                                            <kanban create="false" delete="false">
                                                <templates>
                                                    <t t-name="kanban-box"
                                                        style="width: 240px; 
                                                                height: 120px; 
                                                                padding: 10px; 
                                                                margin: 10px; 
                                                                border: 1px solid #ccc; 
                                                                box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1); 
                                                                border-radius: 5px;">
                                                        <div
                                                            t-attf-class="oe_kanban_content oe_kanban_global_click">
                                                            <div class="o_kanban_record_bottom"
                                                                style="display: flex; justify-content: space-around; align-items: flex-start; padding: 10px;">
                                                                <div
                                                                    class="o_kanban_record_bottom_right"
                                                                    style="margin-right: 10px;">
                                                                    <field name="image_1920"
                                                                        widget="image"
                                                                        class="oe_avatar avatar-hover" />
                                                                </div>
                                                                <div
                                                                    class="o_kanban_record_bottom_left"
                                                                    style="flex-grow: 1; display: flex; flex-direction: column;">
                                                                    <field name="name"
                                                                        style="margin-bottom: 5px; font-weight:bold"></field>
                                                                    <field name="ma_dinh_danh"
                                                                        style="margin-bottom: 5px;"></field>
                                                                    <field name="ref"
                                                                        style="margin-bottom: 5px;"></field>

                                                                </div>
                                                                <div class="delete-button text-end"
                                                                    style="margin-left: 10px;">
                                                                    <a type="delete"
                                                                        name="delete_button_user_ids"
                                                                        class="fa fa-trash" />
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </t>
                                                </templates>
                                            </kanban>
                                        </field>
                                    </div>
                                </group>
                            </div>
                        </div>

                    </page>
                </xpath>

                <xpath expr="//form/sheet/notebook/page[@name='general_information']"
                    position="after">
                    <page string="Hồ sơ xe" name="recordxe">
                        <div style="display:flex; align-items: flex-start;">
                            <sheet>
                                <group>
                                    <field name="image_1920" string="Ảnh trước xe" widget="image"
                                        class="image-zoom-hover " options="{'zoom': true}"
                                        style="max-width: 200px; max-height: 200px; float: left; margin-right: 10px;" />
                                </group>
                                <group>
                                    <field name="image_1920_sau_xe" string="Ảnh sau xe"
                                        widget="image" class="image-zoom-hover"
                                        options="{'zoom': true}"
                                        style="max-width: 200px; max-height: 200px; float: left; margin-right: 10px;" />
                                </group>
                            </sheet>
                            <sheet>
                                <group>
                                    <field name="image_1920_bien_so" widget="image"
                                        class="image-zoom-hover oe-avatar" options="{'zoom': true}"
                                        style="max-width: 200px; max-height: 200px; float: left; margin-right: 10px;" />
                                </group>
                                <group>
                                    <field name="image_1920_cavet_sau" string="Mặt sau CV"
                                        widget="capture_image" class="image-zoom-hover "
                                        options="{'zoom': true}"
                                        style="max-width: 200px; max-height: 200px; float: left; margin-right: 10px;" />
                                </group>
                            </sheet>
                        </div>
                    </page>
                </xpath>

                <xpath expr="//form/sheet/notebook/page[@name='recordxe']" position="after">
                    <page name="inout_history" string="Lịch sử RA/VÀO">
                        <field name="move_history_ids" class="format-fie">
                            <tree create="0" edit="0" default_order="create_date desc">
                                <field name="create_date"></field>
                                <field name="product_id"></field>
                                <field name="image_1920_xe" widget="image"></field>
                                <field name="port"></field>
                                <field name="contact_id"></field>
                                <field name="picking_code" widget="badge"
                                    decoration-muted="picking_code == 'outgoing'"
                                    decoration-success="picking_code == 'incoming'" />
                            </tree>
                        </field>
                    </page>
                </xpath>


                <xpath expr="//form/sheet/notebook/page[@name='inout_history']" position="after">
                    <page name="manager_info" string="Thông tin quản lý">
                        <sheet>
                            <group>
                                <group>
                                    <field name="default_code" />
                                    <field name="barcode" string="Mật khẩu" password="true"></field>
                                </group>
                            </group>
                        </sheet>
                    </page>
                </xpath>
                <xpath expr="//form/sheet/div[@class='oe_title']" position="after">
                    <label for="check_doi_the" string="Xe trong bãi"
                        style="font-size:20px; padding-right:5px" />
                    <field name='check_doi_the' invisible='0' add-label="Xe trong bãi"
                        style="font-size:20px; padding:10px" />
                    <div id="registered_2">
                        <widget name="web_ribbon" title="XE TRONG BÃI" bg_color="bg-success"
                            invisible="check_doi_the == 0" />
                    </div>
                    <separator string="Thông tin xe" />

                    <div class="o_row" style="display: flex; align-items: flex-start;">
                        <div class="o_col-12" style="flex: 1;">
                            <group>
                                <field name='categ_id' widget="many2one"
                                    options="{'no_create':False, 'no_create_edit':False, 'no_open': True}" />
                                <label for="color_id" string="Màu xe" />
                                <div class="o_row" style="display: flex;">
                                    <field name="html_color" class="oe_inline" string=""
                                        widget="color" />
                                    <span>
                                        <field name="color_id" widget="many2one"
                                            options="{'no_create':True, 'no_create_edit':True, 'no_open': True}" />
                                    </span>
                                </div>
                            </group>
                        </div>

                        <div class="o_col-4" style="flex: 1;">
                            <group>
                                <field name='so_khung' string="Số khung"
                                    placeholder="e.g. RUY19008811" />
                                <field name='so_may' string="Số máy" placeholder="JF08E-0028585" />
                                <field name='so_dang_ky' string="Số đăng ký (Mặt sau cà vẹt)"
                                    placeholder="Nhập số..." />
                            </group>
                        </div>

                        <div class="o_col-4" style="flex: 1; display: flex; align-items: center;">
                            <div style="width: 100%; margin-left: 20px;" class="image-zoom-hover ">
                                <field name="image_1920_cavet_truoc" widget="image" nolabel="1"
                                    options="{'zoom': true}"
                                    style="max-width: 200px; max-height: 200px; margin-top: 0px;" />
                            </div>
                        </div>
                    </div>
                </xpath>

            </field>
        </record>

        <record id="product_template_kanban_inherit" model="ir.ui.view">
            <field name="name">product.template.kanban</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_kanban_view" />
            <field name="arch" type="xml">
                <xpath expr="//strong[@class='o_kanban_record_title']" position="before">
                    Biển số:
                </xpath>
                <!-- <xpath expr="//field[@name='priority']" position="replace"> </xpath> -->
                <xpath expr="//t[@t-if='record.default_code.value']" position="replace"></xpath>
                <xpath expr="//div[@t-if='record.product_variant_count.value &gt; 1']"
                    position="replace"></xpath>
                <xpath expr="//div[@name='product_lst_price']" position="replace">
                </xpath>
                <xpath expr="//div[@t-if='record.show_on_hand_qty_status_button.raw_value']"
                    position="replace">
                </xpath>

                <xpath expr="//div[@class='o_kanban_record_top mb-0']" position="after">
                    <div class="mt-1">
                        <field name='contact_id' widget='many2one_avatar'></field>
                    </div>
                    <div class="mt-1">
                        <span class="o_stat_text">VÀO: <b>
                                <field name="nbr_moves_in" modifiers="{&quot;readonly&quot;: true}" />
                            </b>
                        </span>
                    </div>
                    <div class="mt-1">
                        <span class="o_stat_text">RA: <b>
                                <field name="nbr_moves_out" modifiers="{&quot;readonly&quot;: true}" />
                            </b>
                        </span>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>