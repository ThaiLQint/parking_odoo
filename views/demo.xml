<form string="Sản phẩm" name="Product Template" js_class="rfid_button">
    <sheet name="product_form">
        <field name="product_variant_count" invisible="1" field_id="product_variant_count_0"/>
        <field name="service_type" widget="radio" invisible="True" field_id="service_type_0"/>
        <field name="visible_expense_policy" invisible="1" field_id="visible_expense_policy_0"/>
        <field name="is_product_variant" invisible="1" field_id="is_product_variant_0"/>
        <field name="attribute_line_ids" invisible="1" on_change="1" field_id="attribute_line_ids_0"/>
        <field name="type" invisible="1" on_change="1" field_id="type_0"/>
        <field name="company_id" invisible="1" on_change="1" can_create="True" can_write="True" field_id="company_id_0"/>
        <field name="fiscal_country_codes" invisible="1" field_id="fiscal_country_codes_0"/>
        <div name="button_box">
            <button type="object" name="action_view_stock_move_lines" class="oe_stat_button" icon="fa-exchange" modifiers="{&quot;invisible&quot;: [[&quot;type&quot;, &quot;not in&quot;, [&quot;product&quot;, &quot;consu&quot;]]]}">
                <div class="o_field_widget o_stat_info mr4">
                    <span class="o_stat_text">In:</span>
                    <span class="o_stat_text">Out:</span>
                </div>
                <div class="o_field_widget o_stat_info">
                    <span class="o_stat_value">
                        <field name="nbr_moves_in" modifiers="{&quot;readonly&quot;: true}" field_id="nbr_moves_in_0"/>
                    </span>
                    <span class="o_stat_value">
                        <field name="nbr_moves_out" modifiers="{&quot;readonly&quot;: true}" field_id="nbr_moves_out_0"/>
                    </span>
                </div>
            </button>
        </div>
        <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger" invisible="active" widget_id="widget_1"/>
        <field name="id" invisible="True" field_id="id_0"/>
        <div class="oe_title">
            <label for="name" string="Biển số"/>
            <h1>
                <div class="d-flex">
                    <field name="priority" widget="priority" class="me-3" field_id="priority_0"/>
                    <field class="text-break" name="name" options="{'line_breaks': False}" widget="text" placeholder="e.g. 54A12123" on_change="1" field_id="name_0"/>
                </div>
            </h1>
        </div>
        <field name="check_doi_the" invisible="1" field_id="check_doi_the_0"/>

        <div id="registered_2">
            <widget name="web_ribbon" title="CHƯA CÓ THẺ" bg_color="bg-success" invisible="check_doi_the == 0" widget_id="widget_2"/>

        </div>
        <group>
            <group>
                <field name="contact_id" widget="many2one_avatar" options="{'no_create':True, 'no_create_edit':True, 'no_open': True}" can_create="True" can_write="True" field_id="contact_id_0"/>
                <field name="default_code" on_change="1" field_id="default_code_0"/>
                <field name="user_ids" widget="many2many_tags_avatar" placeholder="Thêm người dùng" options="{'no_create':True, 'no_create_edit':True, 'no_open': True}" can_create="True" can_write="True" field_id="user_ids_0"/>
                <!-- THÊM MÀU XE: -->



                <field name="default_color" widget="color" field_id="default_color_0"/>
                <!-- <field name="color_1" widget="color" options="{'no_create':False, 'no_create_edit':False, 'no_open': True}" /> -->

                <field name="so_loai" placeholder="SH 125I" options="{'no_create':False, 'no_create_edit':False, 'no_open': True}" field_id="so_loai_0"/>

                <field name="categ_id" widget="many2one" options="{'no_create':False, 'no_create_edit':False, 'no_open': True}" on_change="1" can_create="True" can_write="True" field_id="categ_id_0"/>
            </group>
            <group>
                <!-- <field name='activity_summary' string="Hãng xe" placeholder="Honda, Yamaha..."></field> -->

                <field name="so_khung" string="Số khung" placeholder="e.g. RUY19008811" field_id="so_khung_0"/>
                <field name="move_history_id" options="{'no_create':True, 'no_create_edit':True}" field_id="move_history_id_0"/>

                <field name="so_may" string="Số máy" placeholder="JF08E-0028585" field_id="so_may_0"/>
                <field name="so_dang_ky" string="Số đăng ký (Mặt sau cà vẹt)" placeholder="Nhập số..." field_id="so_dang_ky_0"/>
            </group>

            <group>
                <field name="image_1920" widget="image" on_change="1" field_id="image_1920_0"/>
            </group>
            <group>
                <field name="image_1920_bien_so" widget="image" on_change="1" field_id="image_1920_bien_so_0"/>
            </group>
            <group>
                <field name="image_1920_cavet_sau" widget="capture_image" on_change="1" field_id="image_1920_cavet_sau_0"/>
            </group>
            <group>
                <field name="image_1920_cavet_truoc" widget="capture_image" on_change="1" field_id="image_1920_cavet_truoc_0"/>
            </group>
        </group>
        <div name="options" invisible="1">
            <span class="d-inline-block">
                <field name="sale_ok" on_change="1" field_id="sale_ok_0"/>
                <label for="sale_ok"/>
            </span>
            <span class="d-inline-block">
                <field name="purchase_ok" field_id="purchase_ok_0"/>
                <label for="purchase_ok"/>
            </span>
        </div>
        <notebook invisible="0">
            <page string="Thông tin chung" name="general_information">
                <group>
                    <group name="group_general">
                        <field name="active" invisible="1" field_id="active_0"/>
                        <field name="detailed_type" on_change="1" field_id="detailed_type_0"/>
                        <field name="invoice_policy" required="1" field_id="invoice_policy_0"/>
                        <field name="expense_policy" widget="radio" invisible="not visible_expense_policy" field_id="expense_policy_0"/>
                        <field name="product_tooltip" string="" class="fst-italic text-muted" invisible="type == 'service' and not sale_ok" field_id="product_tooltip_0"/>
                        <label for="product_tooltip" string="" invisible="type not in ('product', 'consu') or invoice_policy != 'order'"/>
                        <div invisible="type not in ('product', 'consu') or invoice_policy != 'order'" class="fst-italic text-muted">
                    Bạn có thể xuất hóa đơn trước khi sản phẩm được giao. 
                        </div>
                        <label for="product_tooltip" string="" invisible="type not in ('product', 'consu') or invoice_policy != 'delivery'"/>
                        <div invisible="type not in ('product', 'consu') or invoice_policy != 'delivery'" class="fst-italic text-muted">
                    Xuất hóa đơn sau khi giao hàng, dựa trên số lượng đã giao, không phải số lượng đã đặt. 
                        </div>
                        <!-- <field name="uom_id" options="{'no_create': True}" on_change="1" can_create="True" can_write="True" field_id="uom_id_0"/>
                        <field name="uom_po_id" options="{'no_create': True}" on_change="1" can_create="True" can_write="True" field_id="uom_po_id_0"/> -->
                    </group>
                    <group name="group_standard_price">
                        <label for="list_price"/>
                        <div name="pricing" class="o_row">
                            <field name="list_price" class="oe_inline" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}" on_change="1" field_id="list_price_0"/>
                            <span class="ms-2"/>
                            <field name="tax_string" field_id="tax_string_0"/>
                        </div>
                        <!-- <field name="taxes_id" widget="many2many_tags" context="{'default_type_tax_use':'sale', 'search_default_sale': 1, 'search_default_service': type == 'service', 'search_default_goods': type == 'consu'}" on_change="1" can_create="True" can_write="True" field_id="taxes_id_0"/>
                        <label for="standard_price" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                        <div name="standard_price_uom" invisible="product_variant_count &gt; 1 and not is_product_variant">
                            <field name="standard_price" class="oe_inline" widget="monetary" options="{'currency_field': 'cost_currency_id', 'field_digits': True}" field_id="standard_price_0"/>
                            <span>mỗi
                                <field name="uom_name" class="oe_inline" on_change="1" field_id="uom_name_0"/>
                            </span>
                        </div> -->
                        <!-- <field name="categ_id" string="Danh mục sản phẩm" on_change="1" can_create="True" can_write="True" field_id="categ_id_1"/> -->
                        <field name="default_code" invisible="product_variant_count &gt; 1" on_change="1" field_id="default_code_1"/>
                        <field name="categ_id" on_change="1" can_create="True" can_write="True" field_id="categ_id_2"/>
                        <field name="valid_product_template_attribute_line_ids" invisible="1" field_id="valid_product_template_attribute_line_ids_0"/>
                        <field name="barcode" invisible="product_variant_count &gt; 1 or (product_variant_count == 0 and valid_product_template_attribute_line_ids)" field_id="barcode_0"/>
                        <field name="product_tag_ids" widget="many2many_tags" context="{'product_template_id': id}" can_create="True" can_write="True" field_id="product_tag_ids_0"/>
                        <button name="211" icon="oi-arrow-right" type="action" class="btn-link ps-0" colspan="2" string="Cấu hình thẻ"/>
                        <!-- <field name="currency_id" invisible="1" field_id="currency_id_0"/> -->
                        <!-- <field name="cost_currency_id" invisible="1" field_id="cost_currency_id_0"/> -->
                        <field name="product_variant_id" invisible="1" field_id="product_variant_id_0"/>
                    </group>
                    <field name="product_properties" columns="2" field_id="product_properties_0"/>
                </group>
                <group string="Ghi chú nội bộ">
                    <field colspan="2" name="description" nolabel="1" placeholder="Ghi chú này chỉ dành cho mục đích nội bộ." field_id="description_0"/>
                </group>
            </page>
            <page name="variants" string="Thuộc tính &amp; biến thể">
                <field name="attribute_line_ids" widget="one2many" context="{'show_attribute': True}" on_change="1" field_id="attribute_line_ids_1">
                    <tree string="Biến thể" editable="bottom" decoration-info="value_count &lt;= 1">
                        <field name="value_count" column_invisible="True"/>
                        <field name="sequence" widget="handle"/>
                        <field name="attribute_id" readonly="id" on_change="1" can_create="True" can_write="True"/>
                        <field name="value_ids" widget="many2many_tags" options="{'no_create_edit': True, 'color_field': 'color'}" context="{'default_attribute_id': attribute_id, 'show_attribute': False}" on_change="1" can_create="True" can_write="True"/>
                        <button string="Cấu hình" class="float-end btn-secondary" type="object" name="action_open_attribute_values"/>
                    </tree>
                </field>
                <p class="oe_grey oe_edit_only">
                    <strong>Cảnh báo</strong>: việc thêm hoặc xoá thuộc tính sẽ xoá và tạo lại các biến thể hiện có và làm mất các tuỳ chỉnh có thể được áp dụng của chúng.
                </p>
            </page>
            <page string="Bán hàng" name="sales" invisible="not sale_ok">
                <group name="sale">
                    <group string="Bán thêm &amp; bán chéo" name="upsell" invisible="0">
                        <field name="optional_product_ids" widget="many2many_tags" options="{'color_field': 'color'}" domain="[('id', '!=', id), '|', ('company_id', '=', company_id), ('company_id', '=', False)]" placeholder="Đề xuất khi 'Thêm vào giỏ hàng' hoặc báo giá" can_create="True" can_write="True" field_id="optional_product_ids_0"/>
                        <field name="accessory_product_ids" widget="many2many_tags" invisible="not sale_ok" placeholder="Phụ kiện đề xuất trong giỏ hàng thương mại điện tử " can_create="True" can_write="True" field_id="accessory_product_ids_0"/>
                        <field name="alternative_product_ids" widget="many2many_tags" domain="[('id', '!=', id), '|', ('company_id', '=', company_id), ('company_id', '=', False)]" invisible="not sale_ok" placeholder="Hiển thị ở cuối trang sản phẩm " can_create="True" can_write="True" field_id="alternative_product_ids_0"/>
                    </group>
                    <group string="Cửa hàng eCommerce" name="shop" invisible="not sale_ok">
                        <field name="website_url" invisible="1" field_id="website_url_0"/>
                        <field name="website_sequence" field_id="website_sequence_0"/>
                        <field name="public_categ_ids" widget="many2many_tags" string="Danh mục" can_create="True" can_write="True" field_id="public_categ_ids_0"/>
                        <label for="allow_out_of_stock_order" invisible="type in ['service', 'consu']" string="Hết hàng"/>
                        <div invisible="type in ['service', 'consu']">
                            <field name="allow_out_of_stock_order" class="oe_inline" field_id="allow_out_of_stock_order_0"/>
 Tiếp tục bán
                        </div>

                        <label for="show_availability" invisible="type in ['service', 'consu']" string="Hiển thị số lượng hiện có"/>
                        <div invisible="type in ['service', 'consu']">
                            <field name="show_availability" class="oe_inline" field_id="show_availability_0"/>
                            <span invisible="not show_availability">
                                <label for="available_threshold" string="chỉ khi dưới" class="o_light_label"/>
                                <field name="available_threshold" class="oe_inline col-1" widget="integer" field_id="available_threshold_0"/>
                        Đơn vị
                            </span>
                        </div>
                        <field name="out_of_stock_message" invisible="type in ['service', 'consu']" field_id="out_of_stock_message_0"/>
                        <field name="website_ribbon_id" options="{'no_quick_create': True}" can_create="True" can_write="True" field_id="website_ribbon_id_0"/>
                    </group>
                    <group name="product_template_images" string="Phương tiện bổ sung cho sản phẩm" invisible="not sale_ok">
                        <field name="product_template_image_ids" class="o_website_sale_image_list" context="{'default_name': name}" mode="kanban" add-label="Thêm phương tiện" nolabel="1" field_id="product_template_image_ids_0">
                            <kanban string="Hình ảnh sản phẩm" default_order="sequence">
                                <field name="id"/>
                                <field name="name"/>
                                <field name="image_1920"/>
                                <field name="sequence" widget="handle"/>
                                <templates>
                                    <t t-name="kanban-box">
                                        <div class="card oe_kanban_global_click p-0">
                                            <div class="o_squared_image">
                                                <img class="card-img-top" t-att-src="kanban_image('product.image', 'image_1920', record.id.raw_value)" t-att-alt="record.name.value"/>
                                            </div>
                                            <div class="card-body p-0">
                                                <h4 class="card-title p-2 m-0 bg-200">
                                                    <small>
                                                        <field name="name"/>
                                                    </small>
                                                </h4>
                                            </div>
                                            <!-- below 100 Kb: good -->
                                            <t t-if="record.image_1920.raw_value.length &lt; 100*1000">
                                                <t t-set="size_status" t-value="'text-bg-success'"/>
                                                <t t-set="message">Kích thước tệp được chấp nhận</t>
                                            </t>
                                            <!-- below 1000 Kb: decent -->
                                            <t t-elif="record.image_1920.raw_value.length &lt; 1000*1000">
                                                <t t-set="size_status" t-value="'text-bg-warning'"/>
                                                <t t-set="message">Tệp quá lớn. Ảnh nên được tối ưu/giảm kích thước. </t>
                                            </t>
                                            <!-- above 1000 Kb: bad -->
                                            <t t-else="1">
                                                <t t-set="size_status" t-value="'text-bg-danger'"/>
                                                <t t-set="message">Yêu cầu tối ưu hóa! Giảm kích thước hình ảnh hoặc tăng cài đặt nén của bạn.</t>
                                            </t>
                                            <span t-attf-class="badge #{size_status} o_product_image_size" t-esc="record.image_1920.value" t-att-title="message"/>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>
                </group>
                <group>
                    <group string="Mô tả bán hàng" name="description">
                        <field colspan="2" name="description_sale" nolabel="1" placeholder="Ghi chú này hiển thị trên đơn bán hàng và hóa đơn." field_id="description_sale_0"/>
                    </group>
                </group>
            </page>
            <page string="Mua hàng" name="purchase" invisible="not purchase_ok">
                <group name="purchase">
                    <group string="Hoá đơn mua hàng" name="bill">
                        <field name="supplier_taxes_id" widget="many2many_tags" context="{'default_type_tax_use':'purchase', 'search_default_purchase': 1, 'search_default_service': type == 'service', 'search_default_goods': type == 'consu'}" can_create="True" can_write="True" field_id="supplier_taxes_id_0"/>
                    </group>
                </group>
            </page>
            <page string="Tồn kho" name="inventory" invisible="type == 'service'">
                <group name="inventory">
                    <field name="has_available_route_ids" invisible="0" field_id="has_available_route_ids_0"/>
                    <group string="Hoạt động" name="operations">
                        <label for="route_ids" invisible="type == 'service'"/>
                        <div>
                            <field name="route_ids" class="mb-0" widget="many2many_checkboxes" invisible="not has_available_route_ids or type == 'service'" can_create="True" can_write="True" field_id="route_ids_0"/>
                            <button id="stock.view_diagram_button" string="View Diagram" type="action" name="449" icon="oi-arrow-right" invisible="type not in ['product', 'consu']" class="btn btn-link pt-0" context="{'default_product_tmpl_id': id}"/>
                        </div>
                        <field name="route_from_categ_ids" widget="many2many_tags" invisible="not route_from_categ_ids" field_id="route_from_categ_ids_0"/>
                    </group>
                    <group name="group_lots_and_weight" string="Logistics" invisible="type not in ['product', 'consu']">
                        <field name="responsible_id" domain="[('share', '=', False)]" widget="many2one_avatar_user" can_create="True" can_write="True" field_id="responsible_id_0"/>
                        <label for="weight" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                        <div class="o_row" name="weight" invisible="product_variant_count &gt; 1 and not is_product_variant">
                            <field name="weight" class="oe_inline" field_id="weight_0"/>
                            <field name="weight_uom_name" field_id="weight_uom_name_0"/>
                        </div>
                        <label for="volume" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                        <div class="o_row" name="volume" invisible="product_variant_count &gt; 1 and not is_product_variant">
                            <field name="volume" string="Thể tích" class="oe_inline" field_id="volume_0"/>
                            <field name="volume_uom_name" field_id="volume_uom_name_0"/>
                        </div>
                        <label for="sale_delay" invisible="not sale_ok"/>
                        <div invisible="not sale_ok">
                            <field name="sale_delay" class="oe_inline" style="vertical-align:baseline" field_id="sale_delay_0"/>ngày
                        </div>
                        <field name="hs_code" string="Mã HS" field_id="hs_code_0"/>
                        <field name="country_of_origin" can_create="True" can_write="True" field_id="country_of_origin_0"/>
                    </group>
                    <group string="Vị trí đối ứng" name="stock_property">
                        <field name="property_stock_production" can_create="True" can_write="True" field_id="property_stock_production_0"/>
                        <field name="property_stock_inventory" can_create="True" can_write="True" field_id="property_stock_inventory_0"/>
                    </group>
                </group>
                <group>
                    <group string="Mô tả phiếu nhập kho">
                        <field name="description_pickingin" colspan="2" nolabel="1" placeholder="Ghi chú này sẽ được thêm vào phiếu nhập kho (vd: nơi lưu trữ sản phẩm trong kho hàng)." field_id="description_pickingin_0"/>
                    </group>
                    <group string="Mô tả phiếu xuất kho">
                        <field name="description_pickingout" colspan="2" nolabel="1" placeholder="Ghi chú này sẽ hiển thị trên các phiếu xuất kho." field_id="description_pickingout_0"/>
                    </group>
                    <group string="Mô tả phiếu điều chuyển nội bộ">
                        <field name="description_picking" colspan="2" placeholder="Ghi chú này sẽ được thêm vào phiếu điều chuyển nội bộ (vd: nơi lấy sản phẩm trong kho hàng)." nolabel="1" field_id="description_picking_0"/>
                    </group>
                </group>
            </page>
            <page string="Kế toán" name="invoicing">
                <group name="accounting"/>
            </page>
        </notebook>
    </sheet>
    <div class="oe_chatter">
        <field name="message_follower_ids"/>
        <field name="activity_ids"/>
        <field name="message_ids"/>
    </div>
</form>