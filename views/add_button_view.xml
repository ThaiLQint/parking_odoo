<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="add_btn_view" model="ir.ui.view">
        <field name="name">add.action.model.form</field>
        <field name="model">add.action.model</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="open_popup_action" string="Add Color" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="html_color" widget="color" />
                        <field name="html_color" placeholder="Nhập mã màu..." />
                    </group>
                </sheet>
                
            </form>
        </field>
    </record>



</odoo>

