<?xml version="1.0"?>
<odoo>
    <data>
        <record id="rule_readonly_self_user" model="ir.rule">
            <field name="name">Người dùng xe chỉ có thể xem thông tin của chính họ.</field>
            <field name="model_id" ref="parking_odoo.model_res_partner" />
            <field name="groups" eval="[(4, ref('parking_odoo.user_access'))]" />
            <field name="domain_force">[('user_ids.id', '=', user.id)]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="0" />
            <field name="perm_create" eval="0" />
            <field name="perm_unlink" eval="0" />
        </record>

        <record id="readonly_vehicle_user" model="ir.rule">
            <field name="name">Readonly vehicle self</field>
            <field name="model_id" ref="model_product_template" />
            <field name="groups" eval="[(4, ref('parking_odoo.user_access'))]" />
            <field name="domain_force">[('contact_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="0" />
            <field name="perm_create" eval="0" />
            <field name="perm_unlink" eval="0" />
        </record>
    </data>
</odoo>
