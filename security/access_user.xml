<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- LƯU Ý: Tạo Group mới không được trùng lặp id và ghi đè lên gourp cũ 
     ID group quyền (parent) phải khác nhau khi thêm mới -->
    <record id="cate_groups_nsp" model="ir.module.category">
        <field name="name">NSP System</field>
        <field name="sequence">5</field>
    </record>
    <record id="user_access_admin" model="res.groups">
        <field name="name">ADMIN</field>
        <field name="implied_ids" eval="[(4, ref('base.group_erp_manager'))]" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        <field name="category_id"
            ref="parking_odoo.cate_groups_nsp" />
    </record>

    <record id="security_readonly_list" model="res.groups">
        <field name="name">SECURITY</field>
        <field name="category_id"
            ref="parking_odoo.cate_groups_nsp" />
    </record>

    <record id="user_access_operator" model="res.groups">
        <field name="name">OPERATOR</field>
        <field name="category_id"
            ref="parking_odoo.cate_groups_nsp" />
    </record>

    <record id="user_access_manager" model="res.groups">
        <field name="name">MANAGER</field>
        <field name="implied_ids" eval="[(4, ref('base.group_erp_manager'))]" />
        <!-- <field name="domain_force" eval=""> </field> 
         , (4, ref('parking_odoo.group_product_color_main'))-->
        <field name="category_id"
            ref="parking_odoo.cate_groups_nsp" />
    </record>

    <record id="user_access" model="res.groups">
        <field name="name">USER</field>
        <field name="category_id"
            ref="parking_odoo.cate_groups_nsp" />
    </record>

    <record id="access_user_stock_picking" model="ir.model.access">
        <field name="name">access_user_stock_picking</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="group_id" ref="user_access" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="res_users_user_nsp" model="ir.model.access">
        <field name="name">res_users group_user</field>
        <field name="model_id" ref="parking_odoo.model_res_users" />
        <field name="group_id" ref="user_access" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

</odoo>

